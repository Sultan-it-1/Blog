---
layout: layouts/base.njk
bodyClass: page-post
---
{%- set t = i18n[lang] -%}
{%- set prefix = site.languages[lang].prefix -%}
{%- set langPosts = collections.posts | where("data.lang", lang) -%}
{%- set newer = langPosts | getPreviousCollectionItem(page) -%}
{%- set older = langPosts | getNextCollectionItem(page) -%}
{%- set toc = content | toc -%}
{%- set hasToc = toc.length > 2 -%}
{%- set studyMark = studyMarks[page.fileSlug][lang] -%}

{%- macro tocList(items) -%}
<ol class="toc-list{% if numbered %} is-numbered{% endif %}">
  {%- for item in items %}
  <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
  {%- endfor %}
</ol>
{%- endmacro -%}

<article class="post" data-progress-slug="{{ page.fileSlug }}">
  <header class="container post-head">
    <nav class="breadcrumb" aria-label="{{ t.post.blog }}">
      <a href="{{ prefix }}/blog/">{{ t.post.blog }}</a>
      {%- if series %}
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <a href="{{ series | seriesUrl(lang) }}">{{ seriesInfo[series][lang].title }}</a>
      {%- elif tags and tags.length %}
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <a href="{{ tags[0] | tagUrl(lang) }}">{{ tags[0] | topicName(lang) }}</a>
      {%- endif %}
    </nav>
    {%- if series %}
    <a class="series-badge" href="{{ series | seriesUrl(lang) }}">{% icon seriesInfo[series].icon %}<span>{{ t.series.partOf(part) }} <strong>{{ seriesInfo[series][lang].title }}</strong></span></a>
    {%- endif %}
    <h1 class="post-title">{{ title }}</h1>
    {%- if description %}
    <p class="post-lead">{{ description }}</p>
    {%- endif %}
    <ul class="post-meta">
      <li>{% icon "user" %}{{ site.author.name[lang] }}</li>
      <li>{% icon "calendar" %}<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(lang) }}</time></li>
      {%- if updated %}
      <li>{{ t.post.updated }} <time datetime="{{ updated | isoDate }}">{{ updated | readableDate(lang) }}</time></li>
      {%- endif %}
      <li>{% icon "clock" %}{{ t.readingTime(content | readingMinutes) }}</li>
    </ul>
    <div class="hl-tools" data-highlight-tools hidden>
      {%- if studyMark %}
      <button type="button" class="btn hl-tool" aria-pressed="false" data-study-toggle>{% icon "highlighter" %}{{ t.highlight.study }}</button>
      {%- endif %}
      <button type="button" class="btn hl-tool" disabled data-highlight-clear data-confirm="{{ t.highlight.clearConfirm }}">{% icon "close" %}{{ t.highlight.clearAll }}</button>
      {%- if studyMark %}
      <ul class="hl-key" aria-label="{{ t.highlight.keyLabel }}" data-study-key hidden>
        {%- for color in ["yellow", "blue", "green", "pink"] %}
        <li><span class="hl-{{ color }}"></span>{{ t.highlight.key[color] }}</li>
        {%- endfor %}
      </ul>
      <script type="application/json" data-study-marks>{{ studyMark | dump | safe }}</script>
      {%- endif %}
    </div>
  </header>

  <div class="container post-layout{% if hasToc %} has-toc{% endif %}">
    {%- if hasToc %}
    <aside class="post-aside">
      <nav class="toc" aria-label="{{ t.post.toc }}" data-toc>
        <p class="toc-title">{% icon "list" %}{{ t.post.toc }}<span class="toc-count" data-toc-count hidden></span></p>
        {{ tocList(toc) }}
      </nav>
    </aside>
    {%- endif %}

    <div class="post-main">
      {%- if hasToc %}
      <details class="toc-inline">
        <summary>{% icon "list" %}{{ t.post.toc }}<span class="toc-count" data-toc-count hidden></span></summary>
        {{ tocList(toc) }}
      </details>
      {%- endif %}

      <div class="prose{% if numbered %} is-numbered{% endif %}" data-highlightable>
        {{ content | safe }}
      </div>

      <footer class="post-foot">
        {%- if series %}
        {% include "partials/series-nav.njk" %}
        {%- endif %}

        {%- if tags and tags.length %}
        <nav class="chips" aria-label="{{ t.post.topics }}">
          <ul>
            {%- for tag in tags %}
            <li><a class="chip" href="{{ tag | tagUrl(lang) }}">{% tagIcon tag %}{{ tag | topicName(lang) }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- endif %}

        {%- if newer or older %}
        <nav class="post-nav">
          {%- if older %}
          <a class="post-nav-link is-older" href="{{ older.url }}">
            <span class="post-nav-label">{% icon "arrow", "flip-ltr" %}{{ t.post.older }}</span>
            <span class="post-nav-title">{{ older.data.title }}</span>
          </a>
          {%- endif %}
          {%- if newer %}
          <a class="post-nav-link is-newer" href="{{ newer.url }}">
            <span class="post-nav-label">{{ t.post.newer }}{% icon "arrow", "flip-rtl" %}</span>
            <span class="post-nav-title">{{ newer.data.title }}</span>
          </a>
          {%- endif %}
        </nav>
        {%- endif %}
      </footer>
    </div>
  </div>
</article>

<button type="button" class="back-to-top icon-btn" aria-label="{{ t.backToTop }}" title="{{ t.backToTop }}" data-back-to-top hidden>{% icon "arrow-up" %}</button>

<div class="hl-bar" role="toolbar" aria-label="{{ t.highlight.label }}" data-highlight-bar hidden>
  {%- for color in ["yellow", "green", "blue", "pink"] %}
  <button type="button" class="hl-swatch" aria-label="{{ t.highlight[color] }}" title="{{ t.highlight[color] }}" aria-pressed="false" data-highlight-color="{{ color }}"><span class="hl-{{ color }}"></span></button>
  {%- endfor %}
  <button type="button" class="hl-remove" aria-label="{{ t.highlight.remove }}" title="{{ t.highlight.remove }}" data-highlight-remove hidden>{% icon "close" %}</button>
</div>
