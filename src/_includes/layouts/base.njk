{#- Shell for every page: <head>, header, footer. Pages set `lang`, `title`, `description`, `translationKey`. -#}
{%- set t = i18n[lang] -%}
{%- set langInfo = site.languages[lang] -%}
{%- set otherLang = "en" if lang == "ar" else "ar" -%}
{%- set altUrl = collections.all | translationUrl(translationKey, otherLang) -%}
{%- set activeKey = navKey or translationKey -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set pageTitle = (title + " — " + t.siteName) if title else (t.siteName + " — " + t.tagline) -%}
{%- set pageDescription = description or t.siteDescription -%}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ langInfo.dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if altUrl %}
  {#- Language: the reader's saved choice (set by the language button), otherwise the device language —
      Arabic devices read Arabic, every other language reads English. Runs before anything renders and only
      redirects when this page exists in that language. Crawlers and link previews are left on the URL they asked for. #}
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem("lang"); } catch (e) {}
      var device = ((navigator.languages && navigator.languages[0]) || navigator.language || "").toLowerCase();
      var wanted = saved === "ar" || saved === "en" ? saved : device ? (device.indexOf("ar") === 0 ? "ar" : "en") : "{{ lang }}";
      var crawler = navigator.webdriver || /bot|crawl|spider|slurp|facebookexternalhit|whatsapp|preview|lighthouse/i.test(navigator.userAgent);
      if (wanted !== "{{ lang }}" && !crawler) location.replace("{{ altUrl }}" + location.search);
    })();
  </script>
  {%- endif %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author.name[lang] }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ canonical }}">
  {%- if altUrl %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ canonical }}">
  <link rel="alternate" hreflang="{{ otherLang }}" href="{{ altUrl | absoluteUrl(site.url) }}">
  {#- Readers whose language is neither Arabic nor English get the English version. #}
  <link rel="alternate" hreflang="x-default" href="{{ canonical if lang == 'en' else (altUrl | absoluteUrl(site.url)) }}">
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="{{ t.siteName }}" href="{{ langInfo.prefix }}/feed.xml">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ t.siteName }}">
  <meta property="og:title" content="{{ title or t.siteName }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ (image or site.defaultImage) | absoluteUrl(site.url) }}">
  <meta property="og:locale" content="{{ langInfo.ogLocale }}">
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.author.twitter }}">

  <meta name="theme-color" content="{{ brand.colors.light.bg }}" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="{{ brand.colors.dark.bg }}" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  {#- Apply a theme the reader picked before the first paint; otherwise the system setting applies. #}
  <script>try { var theme = localStorage.getItem("theme"); if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme); } catch (e) {}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ brand.fonts.googleFontsUrl }}">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/main.js" defer></script>
</head>
<body class="{{ bodyClass }}" data-copied="{{ t.code.copied }}" data-copy-failed="{{ t.code.failed }}">
  <a class="skip-link" href="#main">{{ t.skip }}</a>

  {% include "partials/header.njk" %}

  <main id="main" class="site-main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
