---
layout: layouts/base.njk
---
<div class="container">
  <header class="page-head">
    {%- if eyebrow %}
    <p class="eyebrow">{{ eyebrow }}</p>
    {%- endif %}
    <h1 class="page-title">{{ title }}</h1>
    {%- if description %}
    <p class="page-lead">{{ description }}</p>
    {%- endif %}
  </header>

  <div class="prose page-prose">
    {{ content | safe }}
  </div>
</div>
