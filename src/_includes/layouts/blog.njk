---
layout: layouts/base.njk
---
{%- set t = i18n[lang] -%}
{%- set posts = collections.posts | where("data.lang", lang) -%}
{%- set langTags = collections.tagPages | where("lang", lang) -%}

<div class="container">
  <header class="page-header">
    <h1>{{ title }}</h1>
    {%- if description %}
    <p>{{ description }}</p>
    {%- endif %}
  </header>

  <div class="search">
    <label for="postSearch" class="visually-hidden">{{ t.blog.searchLabel }}</label>
    <input type="search" id="postSearch" class="search-input" placeholder="{{ t.blog.searchPlaceholder }}" autocomplete="off" data-search-input>
  </div>

  {%- if langTags.length %}
  <nav class="tag-cloud" aria-label="{{ t.blog.tagsTitle }}">
    <ul class="tag-list">
      {%- for tagPage in langTags %}
      <li><a class="tag" href="{{ tagPage.tag | tagUrl(lang) }}">#{{ tagPage.tag }} <span class="tag-count">{{ tagPage.posts.length }}</span></a></li>
      {%- endfor %}
    </ul>
  </nav>
  {%- endif %}

  <ul class="post-grid" data-search-list>
    {%- for post in posts %}
    {% include "partials/post-card.njk" %}
    {%- endfor %}
  </ul>
  <p class="empty-state" data-search-empty hidden>{{ t.blog.noResults }}</p>
</div>
