<header class="site-header" data-header>
  <div class="container header-bar">
    <a href="{{ langInfo.prefix }}/" class="brand" aria-label="{{ t.siteName }} — {{ t.tagline }}">
      {% include "partials/logo-mark.njk" %}
      <span class="brand-word">{{ t.siteName }}</span>
    </a>

    <nav class="site-nav" id="siteNav" aria-label="{{ t.mainNav }}" data-nav>
      <ul class="nav-links" data-nav-links>
        {%- for item in t.nav %}
        <li>
          <a href="{{ langInfo.prefix }}{{ item.path }}" class="nav-link"{% if item.key == activeKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {%- endfor %}
        <li class="nav-indicator" aria-hidden="true" data-nav-indicator></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href="{{ langInfo.prefix }}/blog/#search" aria-label="{{ t.search }}" title="{{ t.search }}">{% icon "search" %}</a>
      <a class="icon-btn lang-btn" href="{{ altUrl or (site.languages[otherLang].prefix + '/') }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}" title="{{ t.switchLanguage }}">
        <span class="lang-code">{{ "ع" if otherLang == "ar" else "EN" }}</span>
        <span class="visually-hidden">{{ t.switchLanguage }}</span>
      </a>
      <button type="button" class="icon-btn theme-btn" data-theme-toggle aria-label="{{ t.toggleTheme }}" title="{{ t.toggleTheme }}">
        {% icon "sun" %}{% icon "moon" %}
      </button>
      <button type="button" class="icon-btn menu-btn" aria-expanded="false" aria-controls="siteNav" data-menu-toggle data-label-open="{{ t.menu }}" data-label-close="{{ t.closeMenu }}" aria-label="{{ t.menu }}">
        {% icon "menu" %}{% icon "close" %}
      </button>
    </div>
  </div>
</header>
<div class="reading-progress" aria-hidden="true" data-progress></div>
