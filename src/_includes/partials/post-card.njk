{#- Expects `post`, `lang` and `t` in scope. -#}
<li class="card post-card" data-search="{{ (post.data.title + ' ' + (post.data.description or '') + ' ' + (post.data.tags or []) | join(' ')) | lower }}">
  <a href="{{ post.url }}" class="post-card-link">
    <h3 class="post-card-title">{{ post.data.title }}</h3>
    {%- if post.data.description %}
    <p class="post-card-excerpt">{{ post.data.description }}</p>
    {%- endif %}
    <p class="post-meta">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate(lang) }}</time>
      <span aria-hidden="true">·</span>
      {{ t.readingTime(post.content | readingMinutes) }}
    </p>
  </a>
</li>
