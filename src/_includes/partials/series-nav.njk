{#- The series panel at the end of a series post: the next part, then the parts of the current section.
    Expects `series` (the key), `part`, `page`, `lang` and `t` in scope. -#}
{%- set seriesData = collections.seriesPages | seriesPage(series, lang) -%}
{%- if seriesData %}
{%- set info = seriesInfo[series][lang] -%}
{%- set currentSection = seriesData | sectionOfPart(part) -%}
{%- set nextItem = seriesData.items | where("n", part + 1) | first -%}
<nav class="series-panel" id="series" aria-label="{{ t.series.parts }}">
  <div class="series-panel-head">
    <p class="eyebrow">{{ t.series.partOf(part) }}</p>
    <a class="series-panel-title" href="{{ series | seriesUrl(lang) }}">{{ info.title }}</a>
  </div>

  {%- if nextItem and nextItem.post %}
  <a class="series-next" href="{{ nextItem.post.url }}">
    <span class="series-next-label">{{ t.series.next }}{% icon "arrow", "flip-rtl" %}</span>
    <span class="series-next-title">{{ nextItem.title }}</span>
  </a>
  {%- elif nextItem %}
  <div class="series-next is-upcoming">
    <span class="series-next-label">{{ t.series.nextSoon }}</span>
    <span class="series-next-title">{{ nextItem.title }}</span>
  </div>
  {%- endif %}

  {%- if currentSection %}
  <div>
    <p class="series-mini-title">{{ t.series.section(currentSection.number, seriesData.sections.length) }}: {{ currentSection.title }}</p>
    <ol class="series-mini">
      {%- for item in currentSection.items %}
      {%- if item.post and item.post.url == page.url %}
      <li class="is-current" data-progress-part="{{ item.post.fileSlug }}"><span class="series-mini-num">{{ item.n }}</span><span aria-current="page">{{ item.title }}</span><span class="visually-hidden" data-progress-label hidden></span></li>
      {%- elif item.post %}
      <li data-progress-part="{{ item.post.fileSlug }}"><span class="series-mini-num">{{ item.n }}</span><a href="{{ item.post.url }}">{{ item.title }}</a><span class="visually-hidden" data-progress-label hidden></span></li>
      {%- else %}
      <li class="is-upcoming"><span class="series-mini-num">{{ item.n }}</span><span>{{ item.title }}</span></li>
      {%- endif %}
      {%- endfor %}
    </ol>
  </div>
  {%- endif %}

  <a class="text-link" href="{{ series | seriesUrl(lang) }}">{{ t.series.allParts }}{% icon "arrow", "flip-rtl" %}</a>
</nav>
{%- endif %}
