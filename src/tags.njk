---
# One page per language + tag: /tags/<tag>/ and /en/tags/<tag>/
layout: layouts/base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: tagPage
  addAllPagesToCollections: true
permalink: "{{ site.languages[tagPage.lang].prefix }}/tags/{{ tagPage.tag | slugify }}/"
navKey: blog
eleventyComputed:
  lang: "{{ tagPage.lang }}"
  title: "{{ tagPage.tag | topicName(tagPage.lang) }}"
  description: "{{ tagPage.tag | topicDescription(tagPage.lang) }}"
  translationKey: "tag:{{ tagPage.tag }}"
---
{%- set t = i18n[lang] -%}
{%- set langTags = collections.tagPages | where("lang", lang) -%}
<div class="container">
  <header class="page-head topic-head">
    <span class="topic-icon topic-icon-lg">{% tagIcon tagPage.tag %}</span>
    <p class="eyebrow">{{ t.tag.eyebrow }} · {{ t.postCount(tagPage.posts.length) }}</p>
    <h1 class="page-title">{{ title }}</h1>
    {%- if description %}
    <p class="page-lead">{{ description }}</p>
    {%- endif %}
  </header>

  <ol class="post-list">
    {%- for post in tagPage.posts %}
    {% include "partials/post-row.njk" %}
    {%- endfor %}
  </ol>

  <nav class="chips chips-footer" aria-label="{{ t.tag.allTopics }}">
    <p class="chips-title">{{ t.tag.allTopics }}</p>
    <ul>
      {%- for topic in langTags %}
      <li><a class="chip" href="{{ topic.tag | tagUrl(lang) }}"{% if topic.tag == tagPage.tag %} aria-current="page"{% endif %}>{% tagIcon topic.tag %}{{ topic.tag | topicName(lang) }}<span class="chip-count">{{ topic.posts.length }}</span></a></li>
      {%- endfor %}
    </ul>
  </nav>
</div>
