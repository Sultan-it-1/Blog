---
# One page per series + language: /series/<key>/ and /en/series/<key>/
layout: layouts/base.njk
pagination:
  data: collections.seriesPages
  size: 1
  alias: seriesPage
  addAllPagesToCollections: true
permalink: "{{ seriesPage.key | seriesUrl(seriesPage.lang) }}"
navKey: blog
eleventyComputed:
  lang: "{{ seriesPage.lang }}"
  title: "{{ seriesInfo[seriesPage.key][seriesPage.lang].title }}"
  description: "{{ seriesInfo[seriesPage.key][seriesPage.lang].description }}"
  translationKey: "series:{{ seriesPage.key }}"
---
{%- set t = i18n[lang] -%}
{%- set parts = seriesPage.parts -%}

<div class="container" data-progress-series>
  <header class="page-head topic-head">
    <span class="topic-icon topic-icon-lg">{% icon seriesInfo[seriesPage.key].icon %}</span>
    <p class="eyebrow">{{ t.series.eyebrow }} · {{ t.series.published(parts.length, seriesPage.total) }}</p>
    <h1 class="page-title">{{ title }}</h1>
    <p class="page-lead">{{ description }}</p>
    <div class="series-status" data-progress-status hidden>
      <div class="series-progress" aria-hidden="true">
        {%- for part in parts %}<span class="is-done" data-progress-part="{{ part.fileSlug }}"></span>{% endfor -%}
      </div>
      <div class="series-status-row">
        <p class="series-status-text">{{ t.progress.finished }} <span class="series-status-count" data-progress-count></span></p>
        <button type="button" class="series-status-reset" data-progress-reset data-undo-label="{{ t.undo }}">{{ t.progress.reset }}</button>
      </div>
    </div>
    <div class="hero-actions">
      <a href="{{ parts[0].url }}" class="btn btn-primary" data-progress-resume data-resume-label="{{ t.progress.resume }}">{{ t.series.start }}{% icon "arrow", "flip-rtl" %}</a>
      {%- if seriesPage.hasQuiz %}
      <a href="{{ seriesPage.key | seriesUrl(lang) }}quiz/" class="btn">{{ t.quiz.exam.title }}</a>
      {%- endif %}
    </div>
  </header>

  <nav aria-label="{{ t.series.sectionsTitle }}">
    <ol class="series-index">
      {%- for section in seriesPage.sections %}
      {%- set publishedInSection = section.items | selectattr("post") | length %}
      <li>
        <a href="#section-{{ section.number }}">
          <span class="series-index-num">{{ section.number }}</span>
          <span>{{ section.title }}</span>
          <span class="series-index-count">{{ publishedInSection }}/{{ section.items.length }}</span>
        </a>
      </li>
      {%- endfor %}
    </ol>
  </nav>

  {%- for section in seriesPage.sections %}
  <section class="series-section" id="section-{{ section.number }}">
    <h2 class="series-section-title">
      <span class="series-section-num">{{ t.series.section(section.number, seriesPage.sections.length) }}</span>
      <span>{{ section.title }}</span>
    </h2>
    <ol class="series-list">
      {%- for item in section.items %}
      {%- if item.post %}
      <li class="series-item" data-progress-part="{{ item.post.fileSlug }}" data-part-n="{{ item.n }}">
        <span class="series-num">{{ item.n | pad }}</span>
        <div class="series-item-body">
          <h3 class="series-item-title"><a href="{{ item.post.url }}">{{ item.title }}</a></h3>
          {%- if item.post.data.description %}
          <p class="series-item-text">{{ item.post.data.description }}</p>
          {%- endif %}
          <p class="series-item-meta">{% icon "clock" %}{{ t.readingTime(item.post.content | readingMinutes) }}<span class="series-item-status" data-progress-label hidden></span><span class="series-item-clear" data-progress-clear hidden><button type="button" aria-label="{{ t.progress.remove }}: {{ item.title }}" data-clear-ask>{{ t.progress.remove }}</button><span class="series-item-confirm" data-clear-confirm hidden>{{ t.progress.removeConfirm }}<span class="series-item-answers"><button type="button" class="is-yes" data-clear-yes>{{ t.progress.yes }}</button><button type="button" data-clear-no>{{ t.progress.no }}</button></span></span></span></p>
        </div>
        <span class="post-row-arrow" aria-hidden="true">{% icon "arrow" %}</span>
      </li>
      {%- else %}
      <li class="series-item is-upcoming">
        <span class="series-num">{{ item.n | pad }}</span>
        <div class="series-item-body">
          <h3 class="series-item-title">{{ item.title }}</h3>
          <p class="series-item-meta">{{ t.series.upcoming }}</p>
        </div>
      </li>
      {%- endif %}
      {%- endfor %}
    </ol>
  </section>
  {%- endfor %}
</div>
