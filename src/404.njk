---
layout: layouts/base.njk
permalink: /404.html
eleventyExcludeFromCollections: true
lang: ar
noindex: true
title: الصفحة غير موجودة
---
{%- set ar = i18n.ar.notFound -%}
{%- set en = i18n.en.notFound -%}
<div class="container not-found">
  <figure class="terminal terminal-compact" dir="ltr" aria-hidden="true">
    <div class="terminal-bar">
      <span class="terminal-dots"><i></i><i></i><i></i></span>
      <span class="terminal-title">bash</span>
    </div>
    <pre class="terminal-body"><span class="t-prompt">$</span> curl -I {{ site.url | replace("https://", "") }}<span class="t-path" data-404-path></span>
<span class="t-out t-error">HTTP/2 404</span>
<span class="t-prompt">$</span> <span class="t-caret"></span></pre>
  </figure>

  <h1 class="page-title">{{ ar.title }}</h1>
  <p class="page-lead">{{ ar.text }}</p>
  <p class="page-lead not-found-en" lang="en" dir="ltr">{{ en.title }}. {{ en.text }}</p>

  <div class="hero-actions">
    <a href="/" class="btn btn-primary">{{ ar.home }}</a>
    <a href="/blog/" class="btn btn-ghost">{{ ar.blog }}</a>
    <a href="/en/" class="btn btn-ghost" lang="en">{{ en.home }}</a>
  </div>
</div>
