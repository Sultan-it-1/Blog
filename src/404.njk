<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الصفحة غير موجودة | Page not found</title>
  <meta name="robots" content="noindex">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <style>
    body {
      background: black;
      color: white;
      margin: 0;
      padding: 0 16px;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
    }

    canvas {
      display: block;
      max-width: 100%;
    }

    .message {
      margin-top: 1rem;
      font-size: 1.5rem;
      max-width: 90%;
    }

    .message-en {
      margin-top: 0.5rem;
      font-size: 1rem;
      opacity: 0.7;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      margin-top: 2rem;
    }

    .btn {
      padding: 0.8rem 2rem;
      background-color: #ffffff22;
      border: 1px solid white;
      border-radius: 5px;
      color: white;
      font-size: 1.2rem;
      transition: background-color 0.3s;
      text-decoration: none;
    }

    .btn:hover {
      background-color: #ffffff44;
    }
  </style>
</head>
<body>
  <canvas id="fuzzyCanvas" aria-label="404"></canvas>

  <p class="message">هالصفحة شكلها ضاعت! تأكد من الرابط أو ارجع للصفحة الرئيسية.</p>
  <p class="message-en" lang="en" dir="ltr">This page seems to be lost. Check the link or go back home.</p>

  <div class="actions">
    <a href="/" class="btn">رجوع للصفحة الرئيسية</a>
    <a href="/en/" class="btn" lang="en">Home</a>
  </div>

  <script>
    const canvas = document.getElementById('fuzzyCanvas');
    const ctx = canvas.getContext('2d');

    const text = '404';
    const fontSize = 'clamp(40px, 20vw, 120px)';
    const fontWeight = 900;
    const fontFamily = 'sans-serif';
    const color = 'red';
    const baseIntensity = 0.18;
    const hoverIntensity = 0.5;
    const fuzzRange = 30;

    let isHovering = false;

    function getFontSizeInPx() {
      const temp = document.createElement('span');
      temp.style.fontSize = fontSize;
      document.body.appendChild(temp);
      const computedSize = parseFloat(window.getComputedStyle(temp).fontSize);
      document.body.removeChild(temp);
      return computedSize;
    }

    function init() {
      const numericFontSize = getFontSizeInPx();

      const offscreen = document.createElement('canvas');
      const offCtx = offscreen.getContext('2d');

      offCtx.font = `${fontWeight} ${numericFontSize}px ${fontFamily}`;
      const width = Math.ceil(offCtx.measureText(text).width + 20);
      const height = Math.ceil(numericFontSize * 1.2);

      offscreen.width = width;
      offscreen.height = height;

      offCtx.font = `${fontWeight} ${numericFontSize}px ${fontFamily}`;
      offCtx.fillStyle = color;
      offCtx.textBaseline = 'top';
      offCtx.fillText(text, 10, 0);

      canvas.width = width + 100;
      canvas.height = height;
      ctx.translate(50, 0);

      const run = () => {
        ctx.clearRect(-fuzzRange, -fuzzRange, canvas.width, canvas.height);
        const intensity = isHovering ? hoverIntensity : baseIntensity;
        for (let j = 0; j < height; j++) {
          const dx = Math.floor(intensity * (Math.random() - 0.5) * fuzzRange);
          ctx.drawImage(offscreen, 0, j, width, 1, dx, j, width, 1);
        }
        requestAnimationFrame(run);
      };
      run();

      const track = (x, y) => {
        isHovering = x >= 0 && x <= width && y >= 0 && y <= height;
      };
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        track(e.clientX - rect.left, e.clientY - rect.top);
      });
      canvas.addEventListener('mouseleave', () => { isHovering = false; });
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        track(touch.clientX - rect.left, touch.clientY - rect.top);
      }, { passive: false });
      canvas.addEventListener('touchend', () => { isHovering = false; });
    }

    window.addEventListener('load', init);
  </script>
</body>
</html>
